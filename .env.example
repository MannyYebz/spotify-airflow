SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9090
# Optional bootstrap alternative to running python -m src.auth in the container.
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_TOKEN_CACHE=.token_cache.json
SPOTIFY_TIME_RANGE=medium_term
SPOTIFY_TOP_LIMIT=50
SPOTIFY_MAX_PAGES=100
SPOTIFY_SCHEDULE=*/15 * * * *
HTTP_ATTEMPTS=4
HTTP_TIMEOUT=30
HTTP_MAX_RETRY_WAIT=120
S3_BUCKET=
S3_PREFIX=spotify
AWS_DEFAULT_REGION=us-east-1
# Omit AWS keys when using an IAM role. Temporary credentials also need a session token.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Generate a hex password so it is safe inside the database URL.
POSTGRES_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=
AIRFLOW_ADMIN_PASSWORD=
